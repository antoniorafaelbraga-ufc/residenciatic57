# URL Base para a chamada da API REST do LLM Institucional
LLM_API_BASE_URL=https://api.institucional.ai/v1/chat/completions

# Sua chave de acesso pessoal (substitua no .env local, nunca coloque sua chave aqui)
LLM_API_KEY=sua_chave_de_api_aqui

# Nome do modelo de linguagem configurado para o curso
LLM_MODEL_NAME=modelo-institucional-v1

# Parâmetros adicionais opcionais (padrões sugeridos para o Bloco 0)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000